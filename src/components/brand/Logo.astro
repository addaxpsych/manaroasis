---
/**
 * Brand lockup: the clinic's own mark plus the wordmark.
 *
 * The mark is a crop of the supplied `logo.jpg` — the mother cradling her baby,
 * flanked by palm shoots, over the star tessellation, with the blue water at the
 * base. It replaces an SVG I had traced from a poster; that was only ever a
 * stand-in for the real artwork.
 *
 * The wordmark stays as live text rather than part of the image: it scales
 * crisply, is selectable and readable by screen readers, and inherits colour so
 * the same component works on both the sand header and the dark green footer.
 */
interface Props {
  class?: string;
  showWordmark?: boolean;
  /** Rendered size of the mark in px. */
  size?: number;
}
const { class: className = '', showWordmark = true, size = 44 } = Astro.props;
---

<span class={`inline-flex items-center gap-3 ${className}`}>
  <img
    src="/images/logo-mark.png"
    alt={showWordmark ? '' : 'واحة د. منار مبارز'}
    aria-hidden={showWordmark ? 'true' : undefined}
    width={size}
    height={size}
    style={`width:${size}px;height:${size}px`}
    class="shrink-0 rounded-full border border-[var(--ornament)]/30 object-cover shadow-sm"
    loading="eager"
    decoding="async"
  />
  {
    showWordmark && (
      <span class="leading-tight">
        <span class="block font-[family-name:var(--font-display)] text-[1.05rem] font-extrabold text-[var(--accent-strong)]">
          واحة د. منار مبارز
        </span>
        <span class="block text-[0.7rem] font-medium tracking-wide text-ink-soft">
          لصحة المرأة والطفل
        </span>
      </span>
    )
  }
</span>

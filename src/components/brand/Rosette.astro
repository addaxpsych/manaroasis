---
/** The eight-point rosette used as a divider and bullet across the posters. */
interface Props { class?: string; size?: number }
const { class: className = '', size = 16 } = Astro.props;
---
<svg
  width={size} height={size} viewBox="0 0 24 24"
  class={className} aria-hidden="true" focusable="false"
>
  <g fill="currentColor">
    <path d="M12 0.5 14 9.2 12 12 10 9.2Z" />
    <path d="M12 23.5 10 14.8 12 12 14 14.8Z" />
    <path d="M0.5 12 9.2 10 12 12 9.2 14Z" />
    <path d="M23.5 12 14.8 14 12 12 14.8 10Z" />
    <path d="M3.9 3.9 10.6 9.2 12 12 9.2 10.6Z" opacity="0.75" />
    <path d="M20.1 20.1 13.4 14.8 12 12 14.8 13.4Z" opacity="0.75" />
    <path d="M20.1 3.9 14.8 10.6 12 12 13.4 9.2Z" opacity="0.75" />
    <path d="M3.9 20.1 9.2 13.4 12 12 10.6 14.8Z" opacity="0.75" />
  </g>
</svg>

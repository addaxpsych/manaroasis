---
import Auth from '../../layouts/Auth.astro';

/**
 * Reached from the recovery email. Supabase sends `?code=…`, which the client
 * exchanges for a temporary session; the user is then allowed to set a new
 * password for exactly that session.
 */
let error = '';
let done = false;

const code = Astro.url.searchParams.get('code');
if (code && Astro.request.method === 'GET') {
  const { error: exchangeError } = await Astro.locals.supabase.auth.exchangeCodeForSession(code);
  if (exchangeError) {
    error = 'الرابط منتهي الصلاحية أو تم استخدامه. اطلبي رابط جديد.';
  }
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const password = String(form.get('password') ?? '');
  const confirm = String(form.get('confirm') ?? '');

  if (password.length < 8) {
    error = 'كلمة المرور لازم تكون 8 حروف على الأقل.';
  } else if (password !== confirm) {
    error = 'كلمتا المرور غير متطابقتين.';
  } else {
    const { error: updateError } = await Astro.locals.supabase.auth.updateUser({ password });
    if (updateError) {
      error = 'انتهت صلاحية الجلسة. اطلبي رابط استعادة جديد.';
    } else {
      done = true;
    }
  }
}

const field =
  'w-full rounded-xl border border-sand-400/60 bg-sand-50 px-4 py-3 text-sm text-ink ' +
  'placeholder:text-ink-faint focus:border-oasis-700 focus:bg-white focus:outline-none focus:ring-2 focus:ring-oasis-700/15';
const label = 'mb-1.5 block text-sm font-semibold text-oasis-900';
---

<Auth
  title="كلمة مرور جديدة"
  description="تعيين كلمة مرور جديدة لحسابك"
  heading={done ? 'تم التغيير' : 'كلمة مرور جديدة'}
  sub={done ? undefined : 'اختاري كلمة مرور جديدة لحسابك.'}
>
  {
    done ? (
      <div class="text-center">
        <p class="leading-loose text-ink-soft">تم تغيير كلمة المرور بنجاح.</p>
        <a
          href="/auth/login"
          class="mt-6 inline-block rounded-xl bg-oasis-900 px-6 py-3 text-sm font-bold text-sand-50 transition hover:bg-oasis-700"
        >
          سجلي دخولك
        </a>
      </div>
    ) : (
      <form method="POST" class="space-y-4">
        {error && (
          <p role="alert" class="rounded-xl border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800">
            {error}
          </p>
        )}

        <div>
          <label class={label} for="password">كلمة المرور الجديدة</label>
          <input
            id="password" name="password" type="password" required minlength={8} autocomplete="new-password"
            dir="ltr" class={`${field} text-start`} placeholder="8 حروف على الأقل"
          />
        </div>

        <div>
          <label class={label} for="confirm">تأكيد كلمة المرور</label>
          <input
            id="confirm" name="confirm" type="password" required minlength={8} autocomplete="new-password"
            dir="ltr" class={`${field} text-start`} placeholder="اكتبيها تاني"
          />
        </div>

        <button
          type="submit"
          class="w-full rounded-xl bg-oasis-900 px-6 py-3.5 text-sm font-bold text-sand-50 transition hover:bg-oasis-700"
        >
          حفظ كلمة المرور
        </button>
      </form>
    )
  }
</Auth>

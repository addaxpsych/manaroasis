---
import Auth from '../../layouts/Auth.astro';

let done = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '').trim();

  if (email) {
    await Astro.locals.supabase.auth.resetPasswordForEmail(email, {
      redirectTo: new URL('/auth/reset-password', Astro.url.origin).href,
    });
  }

  // Always report success. Confirming whether an address exists would leak
  // the clinic's customer list to anyone who can guess emails.
  done = true;
}

const field =
  'w-full rounded-xl border border-sand-400/60 bg-sand-50 px-4 py-3 text-sm text-ink ' +
  'placeholder:text-ink-faint focus:border-oasis-700 focus:bg-white focus:outline-none focus:ring-2 focus:ring-oasis-700/15';
---

<Auth
  title="استعادة كلمة المرور"
  description="استعادة كلمة المرور لحسابك في واحة د. منار مبارز"
  heading={done ? 'راجعي بريدك' : 'نسيتي كلمة المرور؟'}
  sub={done ? undefined : 'اكتبي بريدك وهنبعت لك رابط لتغيير كلمة المرور.'}
>
  {
    done ? (
      <div class="text-center">
        <p class="leading-loose text-ink-soft">
          لو البريد ده مسجل عندنا، هيوصلك رابط لتغيير كلمة المرور خلال دقائق.
          راجعي صندوق الوارد وملف الرسائل غير المرغوبة.
        </p>
        <a href="/auth/login" class="mt-6 inline-block text-sm font-semibold text-oasis-700 hover:text-gold-600">
          العودة لتسجيل الدخول
        </a>
      </div>
    ) : (
      <form method="POST" class="space-y-4">
        <div>
          <label class="mb-1.5 block text-sm font-semibold text-oasis-900" for="email">
            البريد الإلكتروني
          </label>
          <input
            id="email" name="email" type="email" required autocomplete="email"
            dir="ltr" class={`${field} text-start`} placeholder="name@example.com"
          />
        </div>

        <button
          type="submit"
          class="w-full rounded-xl bg-oasis-900 px-6 py-3.5 text-sm font-bold text-sand-50 transition hover:bg-oasis-700"
        >
          أرسلي رابط الاستعادة
        </button>

        <p class="text-center text-sm text-ink-soft">
          <a href="/auth/login" class="font-semibold text-oasis-700 hover:text-gold-600">
            العودة لتسجيل الدخول
          </a>
        </p>
      </form>
    )
  }
</Auth>

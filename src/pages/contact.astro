---
import Marketing from '../layouts/Marketing.astro';
import ContactForm from '../components/islands/ContactForm';
import Rosette from '../components/brand/Rosette.astro';
import WhatsAppIcon from '../components/ui/WhatsAppIcon.astro';
import { site, branches, waLink, telLink, mailLink } from '../config/site';
import { breadcrumbSchema } from '../lib/schema';
---

<Marketing
  title="تواصلي معنا"
  description="للحجز والاستفسار في واحة د. منار مبارز — واتساب 01010429267، أو أرسلي رسالة من الموقع."
  schema={breadcrumbSchema([
    { name: 'الرئيسية', path: '/' },
    { name: 'تواصلي معنا', path: '/contact' },
  ])}
>
  <section class="pattern-sand relative">
    <div class="absolute inset-0 bg-gradient-to-b from-sand-50/85 to-sand-100"></div>
    <div class="relative mx-auto max-w-3xl px-6 py-16 text-center">
      <Rosette size={26} class="mx-auto text-gold-500" />
      <h1 class="mt-5 text-3xl leading-tight text-oasis-900 sm:text-4xl">تواصلي معنا</h1>
      <p class="mt-5 leading-loose text-ink-soft">
        أسرع طريقة للوصول لنا هي واتساب. أو سيبي رسالة هنا وهنرد عليكِ في أقرب وقت.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-20">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.1fr]">
      <aside class="space-y-5">
        <a
          href={waLink('السلام عليكم، حابة أحجز موعد في الواحة')}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-4 rounded-2xl bg-[#1f7a4d] p-6 text-white transition hover:bg-[#186b42]"
        >
          <WhatsAppIcon size={30} />
          <span>
            <span class="block font-bold">واتساب</span>
            <span class="num block text-sm text-white/80">{site.whatsapp}</span>
          </span>
        </a>

        <a
          href={telLink}
          class="flex items-center gap-4 rounded-2xl border border-sand-400/50 bg-white p-6 transition hover:border-gold-500/50"
        >
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-oasis-900">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f7efe1" stroke-width="2" stroke-linecap="round">
              <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" />
            </svg>
          </span>
          <span>
            <span class="block font-bold text-oasis-900">اتصال</span>
            <span class="num block text-sm text-ink-soft">{site.phone}</span>
          </span>
        </a>

        <a
          href={mailLink}
          class="flex items-center gap-4 rounded-2xl border border-sand-400/50 bg-white p-6 transition hover:border-gold-500/50"
        >
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-oasis-900">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f7efe1" stroke-width="2" stroke-linecap="round">
              <path d="m3 7 9 6 9-6M3 7v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V7l-9-4Z" />
            </svg>
          </span>
          <span class="min-w-0">
            <span class="block font-bold text-oasis-900">البريد الإلكتروني</span>
            <span class="block truncate text-sm text-ink-soft" dir="ltr">{site.email}</span>
          </span>
        </a>

        <div class="rounded-2xl border border-sand-400/50 bg-white p-6">
          <h2 class="text-base font-bold text-oasis-900">أماكن العيادات</h2>
          <ul class="mt-4 space-y-4">
            {
              branches.map((b) => (
                <li>
                  <p class="flex items-center gap-2 text-sm font-bold text-oasis-900">
                    <Rosette size={11} class="text-gold-500" />
                    {b.name}
                  </p>
                  <p class="mt-1 text-xs leading-relaxed text-ink-soft">{b.building}</p>
                </li>
              ))
            }
          </ul>
          <a href="/locations" class="mt-5 inline-block text-sm font-semibold text-oasis-700 hover:text-gold-600">
            التفاصيل والخرائط ←
          </a>
        </div>
      </aside>

      <div class="rounded-[3rem_3rem_1rem_1rem] border border-sand-400/50 bg-white p-8">
        <ContactForm client:load whatsappHref={waLink('السلام عليكم، عندي استفسار')} />
      </div>
    </div>
  </section>
</Marketing>

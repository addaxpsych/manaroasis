---
export const prerender = true;

import Marketing from '../layouts/Marketing.astro';
import Divider from '../components/brand/Divider.astro';
import { site } from '../config/site';

const updated = '٣٠ أغسطس ٢٠٢٦';
---

<Marketing
  title="سياسة الخصوصية"
  description="كيف نتعامل مع بياناتك في موقع واحة د. منار مبارز."
>
  <section class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="text-3xl text-oasis-900">سياسة الخصوصية</h1>
    <p class="mt-2 text-sm text-ink-faint">آخر تحديث: {updated}</p>

    <Divider class="my-8" />

    <div class="prose-ar text-[0.98rem] leading-loose text-ink-soft">
      <h2 class="text-xl text-oasis-900">البيانات اللي بنجمعها</h2>
      <p>لما تستخدمي الموقع، ممكن نجمع:</p>
      <ul class="mt-3 list-disc space-y-1.5 ps-6">
        <li>بيانات التواصل اللي بتكتبيها بنفسك: الاسم، رقم الموبايل، البريد الإلكتروني، والمدينة.</li>
        <li>محتوى الرسائل أو طلبات الالتحاق اللي بتبعتيها.</li>
        <li>بيانات حسابك وتقدمك في الكورسات لو سجلتي.</li>
      </ul>

      <h2 class="mt-8 text-xl text-oasis-900">إحنا بنستخدمها في إيه</h2>
      <ul class="mt-3 list-disc space-y-1.5 ps-6">
        <li>الرد على استفساراتك وحجز مواعيدك.</li>
        <li>تفعيل اشتراكك في الكورسات ومتابعة تقدمك.</li>
        <li>إرسال رسائل تتعلق بحسابك أو بالكورس اللي اشتركتي فيه.</li>
      </ul>
      <p class="mt-4">
        إحنا مابنبيعش بياناتك ولا بنشاركها مع أي جهة لأغراض تسويقية.
      </p>

      <h2 class="mt-8 text-xl text-oasis-900">البيانات الطبية</h2>
      <p>
        نماذج التواصل في الموقع مش قناة طبية آمنة. من فضلك متكتبيش فيها تفاصيل تشخيصية
        أو تقارير طبية. المعلومات الطبية بتتناقش في العيادة أو في الاستشارة المحجوزة.
      </p>

      <h2 class="mt-8 text-xl text-oasis-900">مقدمو الخدمة</h2>
      <p>بنستعين بخدمات خارجية لتشغيل الموقع:</p>
      <ul class="mt-3 list-disc space-y-1.5 ps-6">
        <li><strong>Supabase</strong> — لتخزين الحسابات وبيانات الاشتراكات.</li>
        <li><strong>Resend</strong> — لإرسال رسائل البريد الإلكتروني.</li>
        <li><strong>Cloudflare</strong> — لاستضافة الموقع.</li>
      </ul>

      <h2 class="mt-8 text-xl text-oasis-900">حقوقك</h2>
      <p>
        من حقك تطلبي نسخة من بياناتك، أو تصحيحها، أو حذف حسابك. ابعتي لنا على
        <a href={`mailto:${site.email}`} class="font-semibold text-oasis-700" dir="ltr">{site.email}</a>
        وهنرد عليكِ.
      </p>

      <h2 class="mt-8 text-xl text-oasis-900">التواصل</h2>
      <p>
        لأي استفسار بخصوص الخصوصية، كلمينا على
        <span class="num font-semibold text-oasis-700">{site.phone}</span>
        أو على البريد الإلكتروني الموضح أعلاه.
      </p>
    </div>
  </section>
</Marketing>

---
export const prerender = true;

import Marketing from '../../layouts/Marketing.astro';
import Button from '../../components/ui/Button.astro';
import Rosette from '../../components/brand/Rosette.astro';
import Divider from '../../components/brand/Divider.astro';
import WhatsAppIcon from '../../components/ui/WhatsAppIcon.astro';
import { services } from '../../config/services';
import { team } from '../../config/team';
import { branches, waLink, telLink, site } from '../../config/site';
import { breadcrumbSchema } from '../../lib/schema';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const doctors = service.doctors
  .map((slug) => team.find((d) => d.slug === slug))
  .filter((d): d is NonNullable<typeof d> => Boolean(d));

const waMessage = `السلام عليكم، حابة أحجز موعد في ${service.title}`;
---

<Marketing
  title={service.title}
  description={service.summary}
  waMessage={waMessage}
  schema={breadcrumbSchema([
    { name: 'الرئيسية', path: '/' },
    { name: 'العيادات', path: '/services' },
    { name: service.title, path: `/services/${service.slug}` },
  ])}
>
  <section class="pattern-sand relative">
    <div class="absolute inset-0 bg-gradient-to-b from-sand-50/85 to-sand-100"></div>
    <div class="relative mx-auto max-w-4xl px-6 py-16 text-center">
      <nav aria-label="مسار التنقل" class="mb-6 text-xs text-ink-faint">
        <a href="/" class="hover:text-oasis-700">الرئيسية</a>
        <span class="mx-2">/</span>
        <a href="/services" class="hover:text-oasis-700">العيادات</a>
      </nav>

      <Rosette size={26} class="mx-auto text-gold-500" />
      <h1 class="mt-5 text-3xl leading-tight text-oasis-900 sm:text-4xl">{service.title}</h1>
      <p class="mx-auto mt-5 max-w-2xl leading-loose text-ink-soft">{service.summary}</p>

      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button href={waLink(waMessage)} variant="whatsapp" size="lg" external>
          <WhatsAppIcon size={18} /> احجزي على واتساب
        </Button>
        <Button href={telLink} variant="outline" size="lg">
          اتصلي بنا
        </Button>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-16">
    <div class="grid gap-12 lg:grid-cols-[1.3fr_1fr]">
      <div>
        <div class="prose-ar text-[1rem] leading-loose text-ink-soft">
          {service.body.map((p) => <p>{p}</p>)}
        </div>

        <Divider class="my-10" />

        <h2 class="text-2xl text-oasis-900">بنساعدك في</h2>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {
            service.helpsWith.map((item) => (
              <li class="flex items-start gap-2.5 rounded-xl border border-sand-400/45 bg-white px-4 py-3 text-sm text-ink-soft">
                <Rosette size={13} class="mt-1.5 shrink-0 text-gold-500" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <aside class="space-y-6">
        <div class="rounded-2xl border border-sand-400/50 bg-white p-6">
          <h2 class="text-lg text-oasis-900">الفريق</h2>
          <ul class="mt-5 space-y-5">
            {
              doctors.map((d) => (
                <li>
                  <a href={`/team/${d.slug}`} class="group flex items-center gap-3.5">
                    <img
                      src={d.photo}
                      alt={d.name}
                      width="120"
                      height="150"
                      loading="lazy"
                      class="h-16 w-14 shrink-0 rounded-[1.75rem_1.75rem_0.5rem_0.5rem] border border-sand-400/50 object-cover"
                    />
                    <span>
                      <span class="block text-sm font-bold text-oasis-900 group-hover:text-gold-600">
                        {d.name}
                      </span>
                      <span class="mt-0.5 block text-xs leading-relaxed text-ink-soft">{d.role}</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="rounded-2xl border border-sand-400/50 bg-oasis-900 p-6 text-sand-100">
          <h2 class="text-lg text-sand-50">أماكن العيادة</h2>
          <ul class="mt-4 space-y-3 text-sm text-sand-200/75">
            {
              branches.map((b) => (
                <li>
                  <span class="font-semibold text-sand-100">{b.name}</span>
                  <span class="block text-xs text-sand-200/60">{b.building}</span>
                </li>
              ))
            }
          </ul>
          <p class="mt-5 border-t border-sand-200/15 pt-4 text-sm">
            <a href={telLink} class="num font-semibold text-gold-400">{site.phone}</a>
          </p>
        </div>
      </aside>
    </div>
  </section>
</Marketing>

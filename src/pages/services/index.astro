---
export const prerender = true;

import Marketing from '../../layouts/Marketing.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Rosette from '../../components/brand/Rosette.astro';
import { services } from '../../config/services';
import { team } from '../../config/team';
import { breadcrumbSchema } from '../../lib/schema';

const doctorName = (slug: string) => team.find((d) => d.slug === slug)?.name ?? '';
---

<Marketing
  title="العيادات"
  description="ثمان عيادات متخصصة في صحة المرأة والطفل: الرضاعة، التغذية العلاجية، السكر والغدد، الأطفال، جراحة الأطفال، الجراحة العامة، الجلدية، وكوتشينج نوم الأطفال."
  schema={breadcrumbSchema([
    { name: 'الرئيسية', path: '/' },
    { name: 'العيادات', path: '/services' },
  ])}
>
  <section class="pattern-sand relative">
    <div class="absolute inset-0 bg-gradient-to-b from-sand-50/85 to-sand-100"></div>
    <div class="relative mx-auto max-w-7xl px-6 py-16">
      <SectionHeading
        eyebrow="العيادات"
        title="ثمان عيادات، رحلة واحدة"
        lead="من التخطيط للحمل، للرضاعة، لتغذية الأسرة، لصحة الأطفال — الفريق كله في مكان واحد، وبيتكلم مع بعضه في حالتك."
        align="center"
      />
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 pb-20">
    <div class="grid gap-6 md:grid-cols-2">
      {
        services.map((s) => (
          <article class="group flex flex-col rounded-[3rem_3rem_1rem_1rem] border border-sand-400/50 bg-white p-8 transition duration-300 hover:-translate-y-1 hover:border-gold-500/50 hover:shadow-lg hover:shadow-oasis-900/5">
            <Rosette size={20} class="text-gold-500" />
            <h2 class="mt-4 text-xl text-oasis-900">
              <a href={`/services/${s.slug}`} class="after:absolute after:inset-0">
                {s.title}
              </a>
            </h2>
            <p class="mt-3 text-sm leading-loose text-ink-soft">{s.summary}</p>

            <ul class="mt-5 flex flex-wrap gap-2">
              {s.helpsWith.slice(0, 4).map((h) => (
                <li class="rounded-full border border-sand-400/50 bg-sand-50 px-3 py-1 text-xs text-ink-soft">
                  {h}
                </li>
              ))}
            </ul>

            <p class="mt-5 border-t border-sand-400/40 pt-4 text-xs text-ink-faint">
              مع {s.doctors.map((d) => doctorName(d)).join(' · ')}
            </p>
          </article>
        ))
      }
    </div>
  </section>
</Marketing>

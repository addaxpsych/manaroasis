---
export const prerender = true;

import Marketing from '../../layouts/Marketing.astro';
import Button from '../../components/ui/Button.astro';
import Rosette from '../../components/brand/Rosette.astro';
import WhatsAppIcon from '../../components/ui/WhatsAppIcon.astro';
import { team } from '../../config/team';
import { services } from '../../config/services';
import { waLink, telLink } from '../../config/site';
import { doctorSchema, breadcrumbSchema } from '../../lib/schema';

export function getStaticPaths() {
  return team.map((doctor) => ({
    params: { slug: doctor.slug },
    props: { doctor },
  }));
}

const { doctor } = Astro.props;
const relatedServices = services.filter((s) => s.doctors.includes(doctor.slug));
const waMessage = `السلام عليكم، حابة أحجز موعد مع ${doctor.name}`;

const schema = [doctorSchema(doctor.slug), breadcrumbSchema([
  { name: 'الرئيسية', path: '/' },
  { name: 'فريق الواحة', path: '/team' },
  { name: doctor.name, path: `/team/${doctor.slug}` },
])].filter(Boolean) as Record<string, unknown>[];
---

<Marketing
  title={doctor.name}
  description={`${doctor.name} — ${doctor.role}. ${doctor.credentials.join('، ')}.`}
  image={doctor.photo}
  waMessage={waMessage}
  schema={schema}
>
  <section class="pattern-sand relative">
    <div class="absolute inset-0 bg-gradient-to-b from-sand-50/85 to-sand-100"></div>
    <div class="relative mx-auto grid max-w-5xl items-center gap-10 px-6 py-16 md:grid-cols-[0.8fr_1.2fr]">
      <div class="relative mx-auto w-full max-w-xs">
        <div class="absolute -inset-3 rounded-[7rem_7rem_1.5rem_1.5rem] border border-gold-500/25"></div>
        <img
          src={doctor.photo}
          alt={doctor.name}
          width="800"
          height="1000"
          loading="eager"
          class="relative aspect-[4/5] w-full rounded-[6rem_6rem_1rem_1rem] border border-sand-400/50 object-cover shadow-xl shadow-oasis-900/10"
        />
      </div>

      <div>
        <nav aria-label="مسار التنقل" class="mb-5 text-xs text-ink-faint">
          <a href="/" class="hover:text-oasis-700">الرئيسية</a>
          <span class="mx-2">/</span>
          <a href="/team" class="hover:text-oasis-700">فريق الواحة</a>
        </nav>

        <h1 class="text-3xl leading-tight text-oasis-900 sm:text-4xl">{doctor.name}</h1>
        <p class="mt-2 text-lg text-gold-600">{doctor.role}</p>

        <ul class="mt-7 space-y-2.5">
          {
            doctor.credentials.map((c) => (
              <li class="flex items-start gap-2.5 text-sm leading-relaxed text-ink-soft">
                <Rosette size={12} class="mt-1.5 shrink-0 text-gold-500" />
                <span>{c}</span>
              </li>
            ))
          }
        </ul>

        <div class="mt-9 flex flex-wrap gap-3">
          <Button href={waLink(waMessage)} variant="whatsapp" external>
            <WhatsAppIcon size={17} /> احجزي موعد
          </Button>
          <Button href={telLink} variant="outline">اتصلي بنا</Button>
        </div>
      </div>
    </div>
  </section>

  {
    relatedServices.length > 0 && (
      <section class="mx-auto max-w-5xl px-6 py-16">
        <h2 class="text-2xl text-oasis-900">العيادات</h2>
        <div class="mt-6 grid gap-5 sm:grid-cols-2">
          {relatedServices.map((s) => (
            <a
              href={`/services/${s.slug}`}
              class="group rounded-2xl border border-sand-400/50 bg-white p-6 transition hover:-translate-y-1 hover:border-gold-500/50 hover:shadow-lg hover:shadow-oasis-900/5"
            >
              <Rosette size={17} class="text-gold-500" />
              <h3 class="mt-3 text-lg text-oasis-900">{s.title}</h3>
              <p class="mt-2 text-sm leading-loose text-ink-soft">{s.summary}</p>
            </a>
          ))}
        </div>
      </section>
    )
  }
</Marketing>

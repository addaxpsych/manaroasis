---
import Dashboard from '../../../layouts/Dashboard.astro';
import Rosette from '../../../components/brand/Rosette.astro';
import { requireAdmin } from '../../../lib/guards';
import { getCourseOutline, progressPercent } from '../../../lib/courses';
import { waLink } from '../../../config/site';

const auth = requireAdmin(Astro);
if ('redirect' in auth) return auth.redirect;
const { profile } = auth;

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/students');

const supabase = Astro.locals.supabase;

const { data: student } = await supabase
  .from('profiles')
  .select('*')
  .eq('id', id)
  .maybeSingle();

if (!student) return Astro.redirect('/admin/students');

const { data: enrollments } = await supabase
  .from('enrollments')
  .select('*, course:courses(id, slug, title_ar)')
  .eq('user_id', id)
  .order('created_at', { ascending: false });

const { data: progressRows } = await supabase
  .from('lesson_progress')
  .select('lesson_id, completed_at')
  .eq('user_id', id)
  .not('completed_at', 'is', null);

const completedIds = new Set((progressRows ?? []).map((p) => p.lesson_id));

/* Per-lesson breakdown for each enrolled course. Admins read lessons through
   the is_admin() branch of the lessons policy, so nothing is hidden here. */
const details = await Promise.all(
  ((enrollments ?? []) as any[]).map(async (enrollment) => {
    const slug = enrollment.course?.slug;
    const outline = slug ? await getCourseOutline(supabase, slug) : null;
    return { enrollment, outline };
  }),
);

const formatDate = (iso: string | null) =>
  iso ? new Date(iso).toLocaleDateString('ar-EG', { day: 'numeric', month: 'long', year: 'numeric' }) : '—';
---

<Dashboard title={student.full_name || 'دارسة'} profile={profile} admin>
  <nav aria-label="مسار التنقل" class="mb-5 text-xs text-ink-faint">
    <a href="/admin/students" class="hover:text-oasis-700">الدارسات</a>
    <span class="mx-2">/</span>
    <span>{student.full_name || 'بدون اسم'}</span>
  </nav>

  <header class="rounded-2xl border border-sand-400/50 bg-white p-7">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="text-2xl text-oasis-900">{student.full_name || 'بدون اسم'}</h1>
        <p class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-sm text-ink-soft">
          {student.phone && <span class="num" dir="ltr">{student.phone}</span>}
          {student.city && <span>{student.city}</span>}
          <span>انضمت في {formatDate(student.created_at)}</span>
        </p>
      </div>
      {
        student.phone && (
          <a
            href={waLink(`السلام عليكم ${student.full_name}`)}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-xl bg-[#1f7a4d] px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-[#186b42]"
          >
            واتساب
          </a>
        )
      }
    </div>
  </header>

  {
    details.length === 0 ? (
      <p class="mt-6 rounded-2xl border border-sand-400/50 bg-white p-10 text-center text-sm text-ink-soft">
        الدارسة دي مش مشتركة في أي كورس.
      </p>
    ) : (
      <div class="mt-6 space-y-6">
        {details.map(({ enrollment, outline }) => {
          const lessons = outline?.modules.flatMap((m) => m.lessons) ?? [];
          const done = lessons.filter((l) => completedIds.has(l.id)).length;
          const percent = progressPercent(lessons.length, done);

          return (
            <section class="overflow-hidden rounded-2xl border border-sand-400/50 bg-white">
              <header class="border-b border-sand-400/50 bg-sand-50 px-6 py-5">
                <div class="flex flex-wrap items-center justify-between gap-4">
                  <div>
                    <h2 class="text-lg text-oasis-900">{enrollment.course?.title_ar ?? '—'}</h2>
                    <p class="mt-1 text-xs text-ink-soft">
                      {enrollment.status === 'active' ? 'مفعّل' : enrollment.status} ·
                      بدأ في {formatDate(enrollment.starts_at)}
                      {enrollment.amount_paid_egp
                        ? ` · دفعت ${enrollment.amount_paid_egp} ج.م`
                        : ''}
                      {enrollment.payment_method ? ` (${enrollment.payment_method})` : ''}
                    </p>
                  </div>
                  <div class="flex items-center gap-3">
                    <div class="h-2 w-28 overflow-hidden rounded-full bg-sand-200">
                      <div class="h-full rounded-full bg-oasis-700" style={`width:${percent}%`} />
                    </div>
                    <span class="num text-sm font-bold text-oasis-700">{percent}%</span>
                  </div>
                </div>
              </header>

              {outline && outline.modules.length > 0 ? (
                <div class="divide-y divide-sand-400/30">
                  {outline.modules.map((module) => (
                    <div class="px-6 py-4">
                      <h3 class="text-sm font-bold text-oasis-900">{module.title_ar}</h3>
                      <ul class="mt-2.5 space-y-1.5">
                        {module.lessons.map((lesson) => {
                          const isDone = completedIds.has(lesson.id);
                          return (
                            <li class="flex items-center gap-2.5 text-sm">
                              <span
                                class:list={[
                                  'flex h-5 w-5 shrink-0 items-center justify-center rounded-full border text-[10px]',
                                  isDone
                                    ? 'border-oasis-700 bg-oasis-700 text-white'
                                    : 'border-sand-400 text-transparent',
                                ]}
                                aria-hidden="true"
                              >
                                ✓
                              </span>
                              <span class={isDone ? 'text-ink' : 'text-ink-faint'}>
                                {lesson.title_ar}
                              </span>
                            </li>
                          );
                        })}
                      </ul>
                    </div>
                  ))}
                </div>
              ) : (
                <p class="px-6 py-8 text-center text-sm text-ink-soft">
                  <Rosette size={16} class="mx-auto mb-2 text-gold-500" />
                  الكورس ده لسه مالوش دروس.
                </p>
              )}
            </section>
          );
        })}
      </div>
    )
  }
</Dashboard>

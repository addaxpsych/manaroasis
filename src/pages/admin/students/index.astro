---
import Dashboard from '../../../layouts/Dashboard.astro';
import { requireAdmin } from '../../../lib/guards';
import { progressPercent } from '../../../lib/courses';

const auth = requireAdmin(Astro);
if ('redirect' in auth) return auth.redirect;
const { profile } = auth;

const supabase = Astro.locals.supabase;

const { data: enrollments } = await supabase
  .from('enrollments')
  .select('id, status, created_at, user_id, course:courses(id, title_ar, slug), student:profiles!enrollments_user_id_fkey(id, full_name, phone)')
  .order('created_at', { ascending: false })
  .limit(300);

const rows = (enrollments ?? []) as any[];

/* Lesson totals per course and completions per (user, course), computed in two
   queries rather than one per enrollment. */
const courseIds = [...new Set(rows.map((r) => r.course?.id).filter(Boolean))] as string[];
const totals = new Map<string, number>();
const completed = new Map<string, number>();

if (courseIds.length > 0) {
  const { data: modules } = await supabase
    .from('modules')
    .select('id, course_id')
    .in('course_id', courseIds);

  const moduleToCourse = new Map((modules ?? []).map((m) => [m.id, m.course_id]));
  const moduleIds = [...moduleToCourse.keys()];

  if (moduleIds.length > 0) {
    const { data: lessons } = await supabase
      .from('lessons')
      .select('id, module_id')
      .in('module_id', moduleIds);

    const lessonToCourse = new Map<string, string>();
    for (const l of lessons ?? []) {
      const courseId = moduleToCourse.get(l.module_id);
      if (!courseId) continue;
      lessonToCourse.set(l.id, courseId);
      totals.set(courseId, (totals.get(courseId) ?? 0) + 1);
    }

    const { data: progress } = await supabase
      .from('lesson_progress')
      .select('user_id, lesson_id')
      .not('completed_at', 'is', null);

    for (const p of progress ?? []) {
      const courseId = lessonToCourse.get(p.lesson_id);
      if (!courseId) continue;
      const key = `${p.user_id}:${courseId}`;
      completed.set(key, (completed.get(key) ?? 0) + 1);
    }
  }
}

const statusLabel: Record<string, string> = {
  active: 'مفعّل',
  pending: 'معلق',
  expired: 'منتهي',
  cancelled: 'ملغي',
};
---

<Dashboard title="الدارسات" profile={profile} admin>
  <header class="mb-6">
    <h1 class="text-3xl text-oasis-900">الدارسات</h1>
    <p class="mt-2 text-sm text-ink-soft">كل الاشتراكات وتقدم كل دارسة في كورسها.</p>
  </header>

  {
    rows.length === 0 ? (
      <p class="rounded-2xl border border-sand-400/50 bg-white p-10 text-center text-sm text-ink-soft">
        مفيش اشتراكات لسه.
      </p>
    ) : (
      <div class="overflow-x-auto rounded-2xl border border-sand-400/50 bg-white">
        <table class="w-full text-sm">
          <thead class="border-b border-sand-400/50 bg-sand-50 text-xs text-ink-soft">
            <tr>
              <th class="px-5 py-3 text-start font-semibold">الدارسة</th>
              <th class="px-5 py-3 text-start font-semibold">الكورس</th>
              <th class="px-5 py-3 text-start font-semibold">الحالة</th>
              <th class="px-5 py-3 text-start font-semibold">التقدم</th>
              <th class="px-5 py-3 text-start font-semibold" />
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => {
              const courseId = row.course?.id;
              const total = courseId ? (totals.get(courseId) ?? 0) : 0;
              const done = courseId ? (completed.get(`${row.user_id}:${courseId}`) ?? 0) : 0;
              const percent = progressPercent(total, done);

              return (
                <tr class="border-b border-sand-400/30 last:border-0">
                  <td class="px-5 py-4">
                    <p class="font-semibold text-oasis-900">{row.student?.full_name || 'بدون اسم'}</p>
                    {row.student?.phone && (
                      <p class="num mt-0.5 text-xs text-ink-faint">{row.student.phone}</p>
                    )}
                  </td>
                  <td class="px-5 py-4 text-ink-soft">{row.course?.title_ar ?? '—'}</td>
                  <td class="px-5 py-4">
                    <span
                      class:list={[
                        'rounded-full px-2.5 py-1 text-xs font-semibold',
                        row.status === 'active'
                          ? 'bg-oasis-700/15 text-oasis-700'
                          : 'bg-sand-200 text-ink-soft',
                      ]}
                    >
                      {statusLabel[row.status] ?? row.status}
                    </span>
                  </td>
                  <td class="px-5 py-4">
                    <div class="flex items-center gap-2.5">
                      <div class="h-2 w-24 overflow-hidden rounded-full bg-sand-200">
                        <div class="h-full rounded-full bg-oasis-700" style={`width:${percent}%`} />
                      </div>
                      <span class="num text-xs font-semibold text-oasis-700">{percent}%</span>
                    </div>
                    <p class="num mt-1 text-xs text-ink-faint">{done} / {total}</p>
                  </td>
                  <td class="px-5 py-4 text-end">
                    <a
                      href={`/admin/students/${row.user_id}`}
                      class="text-xs font-semibold text-oasis-700 hover:text-gold-600"
                    >
                      التفاصيل ←
                    </a>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )
  }
</Dashboard>

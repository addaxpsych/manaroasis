---
import Dashboard from '../../layouts/Dashboard.astro';
import { requireAdmin } from '../../lib/guards';
import { waLink } from '../../config/site';

const auth = requireAdmin(Astro);
if ('redirect' in auth) return auth.redirect;
const { profile } = auth;

const supabase = Astro.locals.supabase;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const id = String(form.get('id') ?? '');
  const status = String(form.get('status') ?? '');
  const allowed = ['new', 'read', 'handled'] as const;
  type Status = (typeof allowed)[number];

  if (id && (allowed as readonly string[]).includes(status)) {
    await supabase
      .from('contact_messages')
      .update({ status: status as Status })
      .eq('id', id);
  }
}

const { data: messages } = await supabase
  .from('contact_messages')
  .select('*')
  .order('created_at', { ascending: false })
  .limit(200);

const kindLabel: Record<string, string> = {
  contact: 'استفسار',
  booking: 'حجز',
  online_consult: 'استشارة أونلاين',
};

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString('ar-EG', {
    day: 'numeric',
    month: 'long',
    hour: '2-digit',
    minute: '2-digit',
  });
---

<Dashboard title="الرسائل" profile={profile} admin>
  <header class="mb-6">
    <h1 class="text-3xl text-oasis-900">الرسائل</h1>
    <p class="mt-2 text-sm text-ink-soft">الرسائل الواردة من نموذج التواصل في الموقع.</p>
  </header>

  {
    (messages ?? []).length === 0 ? (
      <p class="rounded-2xl border border-sand-400/50 bg-white p-10 text-center text-sm text-ink-soft">
        مفيش رسائل لسه.
      </p>
    ) : (
      <div class="space-y-4">
        {(messages ?? []).map((m) => (
          <article
            class:list={[
              'rounded-2xl border bg-white p-6',
              m.status === 'new' ? 'border-gold-500/55' : 'border-sand-400/50',
            ]}
          >
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2.5">
                  <h2 class="font-bold text-oasis-900">{m.name}</h2>
                  <span class="rounded-full bg-sand-200 px-2.5 py-0.5 text-xs text-ink-soft">
                    {kindLabel[m.kind] ?? m.kind}
                  </span>
                  {m.status === 'new' && (
                    <span class="rounded-full bg-gold-200 px-2.5 py-0.5 text-xs font-semibold text-gold-600">
                      جديدة
                    </span>
                  )}
                </div>
                <p class="mt-1.5 flex flex-wrap gap-x-4 text-xs text-ink-faint">
                  <span class="num" dir="ltr">{m.phone}</span>
                  {m.email && <span dir="ltr">{m.email}</span>}
                  <span>{formatDate(m.created_at)}</span>
                </p>
              </div>

              <div class="flex shrink-0 flex-wrap items-center gap-2">
                <a
                  href={waLink(`السلام عليكم ${m.name}`)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-lg bg-[#1f7a4d] px-3.5 py-2 text-xs font-semibold text-white transition hover:bg-[#186b42]"
                >
                  واتساب
                </a>
                {m.status !== 'handled' && (
                  <form method="POST">
                    <input type="hidden" name="id" value={m.id} />
                    <input type="hidden" name="status" value="handled" />
                    <button
                      type="submit"
                      class="rounded-lg border border-sand-400/60 px-3.5 py-2 text-xs font-semibold text-ink-soft transition hover:bg-sand-100"
                    >
                      تم الرد
                    </button>
                  </form>
                )}
              </div>
            </div>

            {m.subject && <p class="mt-4 text-sm font-semibold text-oasis-900">{m.subject}</p>}
            <p class="mt-2 whitespace-pre-wrap text-sm leading-loose text-ink-soft">{m.message}</p>
          </article>
        ))}
      </div>
    )
  }
</Dashboard>

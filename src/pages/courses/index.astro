---
import Marketing from '../../layouts/Marketing.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';
import Rosette from '../../components/brand/Rosette.astro';
import { listPublishedCourses, formatPrice } from '../../lib/courses';
import { waLink } from '../../config/site';

const courses = await listPublishedCourses(Astro.locals.supabase);
---

<Marketing
  title="الكورسات"
  description="كورسات مسجلة بالعربي من واحة د. منار مبارز — الاستعداد للرضاعة قبل الولادة، والجمال يبدأ من الداخل."
>
  <section class="pattern-sand relative">
    <div class="absolute inset-0 bg-gradient-to-b from-sand-50/85 to-sand-100"></div>
    <div class="relative mx-auto max-w-7xl px-6 py-16">
      <SectionHeading
        eyebrow="كورسات الواحة"
        title="اتعلمي في وقتك، من بيتك"
        lead="كورسات مسجلة بالعربي، تقدري تتفرجي عليها في أي وقت. تقدمك بيتحفظ تلقائياً عشان تكملي من حيث ما وقفتي."
        align="center"
      />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-20">
    {
      courses.length === 0 ? (
        <div class="rounded-[3rem_3rem_1rem_1rem] border border-sand-400/50 bg-white p-12 text-center">
          <Rosette size={26} class="mx-auto text-gold-500" />
          <h2 class="mt-5 text-2xl text-oasis-900">الكورسات في الطريق</h2>
          <p class="mx-auto mt-4 max-w-md leading-loose text-ink-soft">
            بنجهز الكورسات دلوقتي. سيبي لنا رسالة على واتساب وهنبلغك أول ما تُفتح
            أبواب التسجيل.
          </p>
          <div class="mt-8">
            <Button
              href={waLink('السلام عليكم، حابة أعرف مواعيد فتح التسجيل في الكورسات')}
              variant="whatsapp"
              size="lg"
              external
            >
              بلغيني أول ما يُفتح التسجيل
            </Button>
          </div>
        </div>
      ) : (
        <div class="grid gap-8 md:grid-cols-2">
          {courses.map((course) => {
            const price = formatPrice(course);
            const botanical = course.theme === 'botanical';
            return (
              <article
                data-theme={course.theme}
                class:list={[
                  'group flex flex-col overflow-hidden rounded-[3.5rem_3.5rem_1rem_1rem] border transition duration-300 hover:-translate-y-1.5 hover:shadow-xl',
                  botanical
                    ? 'border-sage-300/60 bg-cream-100 hover:shadow-sage-700/10'
                    : 'border-sand-400/50 bg-white hover:shadow-oasis-900/10',
                ]}
              >
                {course.cover_image && (
                  <div class="overflow-hidden bg-sand-200">
                    <img
                      src={course.cover_image}
                      alt={course.title_ar}
                      width="1000"
                      height="1000"
                      loading="lazy"
                      class="aspect-square w-full object-cover transition duration-500 group-hover:scale-[1.03]"
                    />
                  </div>
                )}

                <div class="flex flex-1 flex-col p-8">
                  <div class="flex flex-wrap items-center gap-2">
                    {course.delivery_label && (
                      <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-[var(--ornament)]/40 px-3 py-1 text-xs font-semibold text-[var(--accent)]">
                        <Rosette size={10} />
                        {course.delivery_label}
                      </span>
                    )}
                    {course.access === 'free' && !course.coming_soon && (
                      <span class="inline-flex w-fit items-center rounded-full bg-[var(--accent-strong)] px-3 py-1 text-xs font-bold text-white">
                        مجاني للجميع
                      </span>
                    )}
                    {course.coming_soon && (
                      <span class="inline-flex w-fit items-center rounded-full bg-[var(--ornament)] px-3 py-1 text-xs font-bold text-white">
                        قريباً
                      </span>
                    )}
                  </div>

                  <h2 class="mt-4 text-2xl leading-snug text-[var(--accent-strong)]">
                    <a href={`/courses/${course.slug}`} class="after:absolute after:inset-0">
                      {course.title_ar}
                    </a>
                  </h2>

                  {course.hook_ar && (
                    <p class="mt-3 text-sm leading-loose text-ink-soft">«{course.hook_ar}»</p>
                  )}

                  {course.highlights.length > 0 && (
                    <ul class="mt-5 flex flex-wrap gap-2">
                      {course.highlights.slice(0, 4).map((h) => (
                        <li class="rounded-full border border-[var(--hairline)] bg-[var(--surface)] px-3 py-1 text-xs text-ink-soft">
                          {h}
                        </li>
                      ))}
                    </ul>
                  )}

                  <div class="mt-auto flex items-center justify-between gap-4 pt-7">
                    <span class="text-lg font-extrabold text-[var(--accent-strong)]">
                      {
                        course.coming_soon
                          ? 'قريباً'
                          : course.access === 'free'
                            ? 'مجاناً'
                            : price.display
                      }
                    </span>
                    <span class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--accent)]">
                      {
                        course.coming_soon
                          ? 'اعرفي التفاصيل'
                          : course.access === 'free'
                            ? 'شاهدي الحلقات'
                            : 'التفاصيل'
                      }
                      <span class="transition group-hover:-translate-x-1">←</span>
                    </span>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      )
    }
  </section>
</Marketing>

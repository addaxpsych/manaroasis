---
import Marketing from '../../../layouts/Marketing.astro';
import Rosette from '../../../components/brand/Rosette.astro';
import Button from '../../../components/ui/Button.astro';
import { getCourseOutline } from '../../../lib/courses';
import { embedUrl } from '../../../lib/video';
import { waLink } from '../../../config/site';
import { breadcrumbSchema } from '../../../lib/schema';

/**
 * Public lesson player.
 *
 * Serves lessons that anyone may watch: every lesson of a `free` course, and
 * the preview lesson of a paid one. Access is not decided here — RLS decides.
 * `can_read_lesson()` only returns preview lessons to an anonymous caller, so
 * a paid lesson simply never appears in the outline and 404s below.
 */
const { slug, lesson: lessonSlug } = Astro.params;
if (!slug || !lessonSlug) return Astro.redirect('/courses');

const course = await getCourseOutline(Astro.locals.supabase, slug);
if (!course || !course.is_published) return Astro.redirect('/courses');

const flat = course.modules.flatMap((m) => m.lessons);
const index = flat.findIndex((l) => l.slug === lessonSlug);

// Not in the outline means RLS filtered it out — send them to the sales page.
if (index === -1) return Astro.redirect(`/courses/${course.slug}`);

const lesson = flat[index];
const previous = index > 0 ? flat[index - 1] : undefined;
const next = index < flat.length - 1 ? flat[index + 1] : undefined;
const video = embedUrl(lesson.video_provider, lesson.video_id);
const isFree = course.access === 'free';
---

<Marketing
  title={lesson.title_ar}
  description={`${lesson.title_ar} — ${course.title_ar}${lesson.content_ar ? ` ${lesson.content_ar}` : ''}`}
  theme={course.theme}
  image={course.cover_image ?? undefined}
  schema={breadcrumbSchema([
    { name: 'الرئيسية', path: '/' },
    { name: 'الكورسات', path: '/courses' },
    { name: course.title_ar, path: `/courses/${course.slug}` },
    { name: lesson.title_ar, path: `/courses/${course.slug}/${lesson.slug}` },
  ])}
>
  <section class="bg-[var(--surface)] py-10">
    <div class="mx-auto max-w-6xl px-6">
      <nav aria-label="مسار التنقل" class="mb-6 text-xs text-ink-faint">
        <a href="/courses" class="hover:text-[var(--accent)]">الكورسات</a>
        <span class="mx-2">/</span>
        <a href={`/courses/${course.slug}`} class="hover:text-[var(--accent)]">{course.title_ar}</a>
      </nav>

      <div class="grid gap-8 lg:grid-cols-[1fr_300px]">
        <article>
          {
            isFree && (
              <span class="inline-flex items-center gap-2 rounded-full bg-[var(--accent)] px-3.5 py-1 text-xs font-bold text-white">
                <Rosette size={11} /> حلقة مجانية
              </span>
            )
          }

          <h1 class="mt-4 text-2xl leading-snug text-[var(--accent-strong)] sm:text-3xl">
            {lesson.title_ar}
          </h1>
          {lesson.content_ar && <p class="mt-2 text-sm text-ink-soft">{lesson.content_ar}</p>}

          {
            video ? (
              <div class="mt-7 overflow-hidden rounded-2xl border border-[var(--hairline)] bg-black">
                <iframe
                  src={video}
                  title={lesson.title_ar}
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen"
                  allowfullscreen
                  class="aspect-video w-full"
                />
              </div>
            ) : (
              <div class="mt-7 flex aspect-video items-center justify-center rounded-2xl border border-dashed border-[var(--hairline)] bg-[var(--surface-sunken)]">
                <p class="text-sm text-ink-soft">الفيديو هيتم رفعه قريباً.</p>
              </div>
            )
          }

          <nav class="mt-8 flex items-center justify-between gap-4 border-t border-[var(--hairline)] pt-6 text-sm">
            {
              previous ? (
                <a
                  href={`/courses/${course.slug}/${previous.slug}`}
                  class="font-semibold text-[var(--accent)] hover:text-[var(--ornament)]"
                >
                  → {previous.title_ar}
                </a>
              ) : (
                <span />
              )
            }
            {
              next ? (
                <a
                  href={`/courses/${course.slug}/${next.slug}`}
                  class="text-end font-semibold text-[var(--accent)] hover:text-[var(--ornament)]"
                >
                  {next.title_ar} ←
                </a>
              ) : (
                <span />
              )
            }
          </nav>

          <div class="mt-10 rounded-2xl border border-[var(--hairline)] bg-[var(--surface-raised)] p-7 text-center">
            <Rosette size={20} class="mx-auto text-[var(--ornament)]" />
            <p class="mt-3 leading-loose text-ink-soft">
              عندك سؤال بخصوص الحلقة دي؟ احجزي موعد وهنتكلم في حالتك بالتفصيل.
            </p>
            <div class="mt-5">
              <Button href={waLink('السلام عليكم، سمعت حلقة من بودكاست الواحة وحابة أحجز موعد')} variant="whatsapp" external>
                احجزي على واتساب
              </Button>
            </div>
          </div>
        </article>

        <aside class="lg:sticky lg:top-28 lg:self-start">
          <div class="rounded-2xl border border-[var(--hairline)] bg-[var(--surface-raised)] p-6">
            <h2 class="text-sm font-bold text-[var(--accent-strong)]">
              {isFree ? 'كل الحلقات' : 'محتوى الكورس'}
            </h2>
            <ol class="mt-4 space-y-1">
              {
                flat.map((item, i) => (
                  <li>
                    <a
                      href={`/courses/${course.slug}/${item.slug}`}
                      aria-current={item.slug === lesson.slug ? 'page' : undefined}
                      class:list={[
                        'flex items-start gap-2.5 rounded-lg px-3 py-2 text-xs leading-relaxed transition',
                        item.slug === lesson.slug
                          ? 'bg-[var(--accent-strong)] text-white'
                          : 'text-ink-soft hover:bg-[var(--surface)]',
                      ]}
                    >
                      <span class="num shrink-0 opacity-60">{i + 1}.</span>
                      <span>{item.title_ar}</span>
                    </a>
                  </li>
                ))
              }
            </ol>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Marketing>

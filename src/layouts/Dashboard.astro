---
import Base from './Base.astro';
import Logo from '../components/brand/Logo.astro';
import type { Profile } from '../lib/supabase/types';

interface Props {
  title: string;
  description?: string;
  profile: Profile;
  /** Renders the admin chrome and highlights admin nav instead. */
  admin?: boolean;
}
const { title, description = '', profile, admin = false } = Astro.props;

const customerNav = [
  { href: '/dashboard', label: 'كورساتي' },
  { href: '/dashboard/profile', label: 'بياناتي' },
];

const adminNav = [
  { href: '/admin', label: 'نظرة عامة' },
  { href: '/admin/requests', label: 'طلبات الالتحاق' },
  { href: '/admin/students', label: 'الدارسات' },
  { href: '/admin/courses', label: 'الكورسات' },
  { href: '/admin/messages', label: 'الرسائل' },
];

const nav = admin ? adminNav : customerNav;
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/dashboard' || href === '/admin' ? path === href : path.startsWith(href);
---

<Base title={title} description={description} noindex>
  <div class="min-h-dvh bg-sand-100">
    <header class="border-b border-sand-400/50 bg-white">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-3.5">
        <a href="/" aria-label="الصفحة الرئيسية"><Logo showWordmark={false} /></a>

        <nav aria-label="لوحة التحكم" class="flex flex-1 items-center gap-1 overflow-x-auto">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'shrink-0 rounded-lg px-3 py-2 text-sm font-medium transition',
                  isActive(item.href)
                    ? 'bg-oasis-900 text-sand-50'
                    : 'text-ink-soft hover:bg-sand-200 hover:text-oasis-900',
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        <div class="flex shrink-0 items-center gap-2">
          {
            /* The admin entry point. It renders only for admins, but that is
               presentation only — every /admin route re-checks the role on the
               server via requireAdmin(). */
            profile.role === 'admin' && !admin && (
              <a
                href="/admin"
                class="hidden rounded-xl bg-gold-500 px-4 py-2 text-sm font-bold text-oasis-900 transition hover:bg-gold-400 sm:inline-flex"
              >
                لوحة تحكم المدير
              </a>
            )
          }
          {
            admin && (
              <a
                href="/dashboard"
                class="hidden rounded-xl border border-sand-400/60 px-4 py-2 text-sm font-semibold text-oasis-900 transition hover:bg-sand-100 sm:inline-flex"
              >
                كورساتي
              </a>
            )
          }
          <form method="POST" action="/auth/signout">
            <button
              type="submit"
              class="rounded-xl border border-sand-400/60 px-3 py-2 text-sm text-ink-soft transition hover:border-red-300 hover:text-red-700"
            >
              خروج
            </button>
          </form>
        </div>
      </div>
    </header>

    <main id="main" class="mx-auto max-w-7xl px-5 py-10">
      <slot />
    </main>
  </div>
</Base>

---
import Base from './Base.astro';
import Logo from '../components/brand/Logo.astro';
import Divider from '../components/brand/Divider.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  sub?: string;
}
const { title, description, heading, sub } = Astro.props;
---

<Base title={title} description={description} noindex>
  <div class="pattern-sand flex min-h-dvh items-center justify-center px-5 py-12">
    <div class="w-full max-w-md">
      <a href="/" class="mb-8 flex justify-center">
        <Logo />
      </a>

      <div class="rounded-[3rem_3rem_1rem_1rem] border border-sand-400/50 bg-white p-8 shadow-sm sm:p-10">
        <h1 class="text-center text-2xl text-oasis-900">{heading}</h1>
        {sub && <p class="mt-2.5 text-center text-sm leading-loose text-ink-soft">{sub}</p>}

        <Divider class="my-7" />

        <slot />
      </div>

      <p class="mt-8 text-center text-xs text-ink-faint">
        <a href="/" class="hover:text-oasis-700">العودة للموقع</a>
      </p>
    </div>
  </div>
</Base>

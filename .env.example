# ─────────────────────────────────────────────────────────────
# واحة د. منار مبارز — environment template
# Copy to `.env` (for `astro build`) and `.dev.vars` (for the
# workerd dev runtime). Neither is committed.
# ─────────────────────────────────────────────────────────────

# Supabase — from Project Settings → API
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never expose to the browser,
# never prefix with PUBLIC_. Set in prod via `wrangler secret put`.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Sending identity. Requires a DNS-verified domain in Resend.
# Until a domain is verified, `onboarding@resend.dev` only delivers
# to your own account address — customer mail will NOT arrive.
EMAIL_FROM=واحة د. منار مبارز <noreply@manaroasis.com>
ADMIN_NOTIFY_EMAIL=Dr.manar.mobarez.clinic@gmail.com

# Public site config
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_WHATSAPP=+201010429267
PUBLIC_PHONE=01010429267
PUBLIC_EMAIL=Dr.manar.mobarez.clinic@gmail.com

# ─────────────────────────────────────────────────────────────
# واحة د. منار مبارز — environment template
# Copy to `.env` (for `astro build`) and `.dev.vars` (for the
# workerd dev runtime). Neither is committed.
# ─────────────────────────────────────────────────────────────

# Supabase — from Project Settings → API
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never expose to the browser,
# never prefix with PUBLIC_. Set in prod via `wrangler secret put`.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Sending identity. Resend requires a DNS-VERIFIED DOMAIN to send to
# anyone other than your own account address. A pages.dev / workers.dev
# subdomain cannot be verified — you need a real domain for email even if
# the site itself is served from a Cloudflare subdomain.
# Until then, keep onboarding@resend.dev and expect delivery ONLY to the
# address that owns the Resend account.
EMAIL_FROM=onboarding@resend.dev
ADMIN_NOTIFY_EMAIL=Dr.manar.mobarez.clinic@gmail.com

# Public site config.
# PUBLIC_SITE_URL must be set at BUILD time as well as runtime — canonical
# URLs, OG tags, JSON-LD and robots/sitemap are baked in during the build.
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_WHATSAPP=+201010429267
PUBLIC_PHONE=01010429267
PUBLIC_EMAIL=Dr.manar.mobarez.clinic@gmail.com
